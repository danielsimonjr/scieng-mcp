# The plugin bundle is generated and committed. Git keeps its text files with LF line endings on
# every platform, so a build on Windows matches the committed bundle byte for byte.
# The engine assets are verbatim copies of the engine package. Git stores their bytes without conversion.
plugin/bundle/**/*.mjs text eol=lf
plugin/bundle/**/*.txt text eol=lf
plugin/bundle/**/*.wasm binary
plugin/bundle/**/*.ttf binary
plugin/bundle/assets/** -text
# The occt licence texts are verbatim copies of the occt-import-js package, with its CRLF line endings.
plugin/bundle/occt*.LICENSE.txt -text
# The manifold-3d licence text is a verbatim copy of the package file.
plugin/bundle/manifold-3d.LICENSE.txt -text
# Test fixtures are byte-exact copies of their sources. Their SHA-256 values are in their README.
test/fixtures/** -text
